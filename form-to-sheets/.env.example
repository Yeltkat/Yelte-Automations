# Copy this file to .env and fill in your own values. Never commit .env.

# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Service account key downloaded from Google Cloud (see README)
GOOGLE_CREDENTIALS_FILE=credentials.json
WORKSHEET_NAME=Submissions

# Optional: other tools must send this value in the X-Webhook-Secret header
WEBHOOK_SECRET=

# Optional: Discord channel webhook URL for a notification on every new request
DISCORD_WEBHOOK_URL=

# Port for the local server (5000 is taken by AirPlay on macOS)
PORT=5050
